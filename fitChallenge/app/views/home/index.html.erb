<div class="container">
    <div class="row justify-content-center mt-4">
        <div class="col-lg-8 text-center">
            <h1 class="mb-2">Welcome to FitChallenge</h1>
            <p class="lead mb-4">Join fitness challenges, track your progress, and earn badges.</p>

            <% if user_signed_in? %>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <%= link_to "Browse challenges", challenges_path, class: "btn btn-primary" %>
                    <%= link_to "Edit account", edit_user_registration_path, class: "btn btn-outline-secondary" %>
                    <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "btn btn-outline-danger" %>
                </div>
            <% else %>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <%= link_to "Sign up", new_user_registration_path, class: "btn btn-success" %>
                    <%= link_to "Log in", new_user_session_path, class: "btn btn-primary" %>
                </div>
            <% end %>
        </div>
    </div>

    <hr class="my-5" />

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Join challenges</h5>
                    <p class="card-text">Find challenges that match your goals and compete with others.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Track progress</h5>
                    <p class="card-text">Log your activity and earn points as you advance.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Earn badges</h5>
                    <p class="card-text">Collect achievements for milestones and consistency.</p>
                </div>
            </div>
        </div>
    </div>
</div>